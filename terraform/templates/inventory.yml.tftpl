# generated by terraform, do not edit by hand
# regenerated on every apply, deleted on every destroy
all:
  children:
    pb_nodes:
      hosts:
%{ for n in nodes ~}
        ${n.name}:
          ansible_host: ${n.ip}
%{ endfor ~}
      vars:
        ansible_user: ${ssh_user}
        ansible_ssh_private_key_file: ${ssh_private_key}
