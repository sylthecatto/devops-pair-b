# Packer outputs & manifests
packer/output/
packer/*.iso
*-manifest.json

# Terraform state & cache memory
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log
terraform/.ssh/

# Ansible dynamic roles & generated inventory
ansible/roles/
ansible/collections/
ansible/inventory/hosts
*.retry

# Secrets & Passwords - NEVER COMMIT TO GIT
ansible/vaultpass.txt
vaultpass.txt
vault_pass
.vault_pass
*.pass
*.pem
*.key

# Goss audit report artifacts generated at runtime
ansible/*.json
goss-reports/*.json
*.json
